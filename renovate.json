{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Automerge GitHub Actions minor, patch, and digest updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github-actions (non-major)",
      "automerge": true
    },
    {
      "description": "Automerge Python requirements minor and patch updates",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "python dependencies (non-major)",
      "automerge": true
    },
    {
      "description": "Automerge Dockerfile patch and digest updates",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Keep all major updates as manual PRs",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
